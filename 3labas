%1
clear
close all
x = -pi:0.1:pi;
f1 = tan(sin(x))+sin(tan(x));
f2 = exp(-0.5*x);
f3 = sin(x);

figure(1)
plot(x, f1, 'Color', 'y')
grid on
title("f(x) = tan(sin(x))+sin(tan(x))")
xlabel('x ašis')
ylabel('f(x) ašis')

figure(2)
subplot(2, 1, 1)
semilogy(x, f2)
grid on 
title("f(x) = exp(-0.5*x)")
xlabel('x ašis')
ylabel('y ašis (logaritminė priklausomybė)')

subplot(2, 1, 2)
plot(x, f3)
grid on
title("f(x) = sin(x)")
xlabel('x ašis')
ylabel('y ašis')

%2
clear
close all
NM = rand(6, 4)
figure
subplot(2, 1, 1)
area(NM)
title('Atsitiktinių reikšmių plotas')
