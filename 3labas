%PAPILDOMA užduotis
clear
close all
%3
t = 0:0.002:1.2;
A = 5.5;
f = 8;
sigma = 0.8;
U1 = 3.5;
U2 = 1.5;

s=A*sin(2*pi*f*t);
n = sigma*randn(size(t));
s=s+n;
s_b = s;
s_b(abs(s_b)<U2) = 0;

figure
subplot(1, 2, 1)
plot(t, s, 'b-', t, s_b, 'y:')
hold on
yline(U1);
yline(U2, ':')
title('Pradinis ir filtruotas signalai')
xlabel("s", 'FontSize', 14, 'FontWeight', 'bold');
ylabel("U", 'FontSize', 14, 'FontWeight', 'bold')
legend('Pradinis', 'Filtruotas', 'U1', 'U2', 'Location', 'bestoutside')

subplot(1, 2, 2)
virsija = s > U1;
stem(t(virsija), s(virsija))
hold on
minU = min(s(virsija))
maxU = max(s(virsija))
minV = virsija & (s == minU);
maxV = virsija & (s == maxU);
maxU = max(s(virsija))
plot(t(minV), s(minV), 'gv', 'MarkerSize', 8)
plot(t(maxV), s(maxV), 'r^', 'MarkerSize', 12)
title('Reikšmės virš U1');
xlabel('Laikas, s')
ylabel('Įtampa, V')
legend('Signalas', 'Minimumai', 'Maksimumai')
ylim([U1 max(s)+0.5])
grid on
